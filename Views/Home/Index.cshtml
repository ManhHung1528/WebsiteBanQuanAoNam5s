@functions {
    public MyDbContext db = new MyDbContext();
    // Lấy 6 sản phẩm nổi bật
    public List<Products> HotProducts()
    {
        List<Products> rows = db.Products.Where(item => item.Hot == 1).OrderByDescending(item => item.Id).Skip(0).Take(8).ToList();
        return rows != null ? rows : new List<Products>();
    }
    //Lấy sản phẩm hiển thị ở trang chủ
    public List<RowCategory> GetCategories()
    {
        List<RowCategory> rows = db.Categories.Where(item => item.DisplayHomePage == 1)
        .OrderByDescending(item => item.Id).ToList();
        return rows != null ? rows : new List<RowCategory>();
    }
    // public List<RowCategory> GetCategories()
    // {
    //     return db.Categories
    //         .OrderByDescending(item => item.Id)
    //         .ToList();
    // }
    // Lấy 6 sản phẩm tương ứng với danh mục
    public List<Products> GetProducts(int categoryId)
    {
        return (
        from p in db.Products
        join cp in db.categoriesProducts
            on p.Id equals cp.ProductId
        where cp.CategoryId == categoryId
        orderby p.Id descending
        select p
    ).Take(6).ToList();
    }
    //lấy 6 sản phẩm nổi bật Tin tức
    public List<News> HotNews()
    {
        List<News> rows = db.News.Where(item => item.Hot == 1).OrderByDescending(item => item.Id).Skip(0).Take(4).ToList();
        return rows != null ? rows : new List<News>();
    }
}
