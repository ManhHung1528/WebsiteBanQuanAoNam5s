<div class="container checkout-page">
    <form method="post" action="/Products/ProductBuy">
        <input type="hidden" name="ProductId" value="@Model.Id" />
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger"> @TempData["ErrorMessage"] </div>
        }
        <div class="row g-4">

            <!-- Cột nhập thông tin giao hàng -->
            <div class="col-12 col-md-4">
                <h3>Thông tin giao hàng</h3>
                <input type="text" name="FullName" placeholder="Họ và tên" required />
                <input type="text" name="Phone" placeholder="Số điện thoại" required />
                <input type="email" name="Email" placeholder="Email" />
                <input type="text" name="Address" placeholder="Địa chỉ cụ thể" required />
                <input type="text" name="City" placeholder="Tỉnh / Thành phố" />
                <input type="text" name="Ward" placeholder="Phường / Xã" />
                <input type="text" name="Note" placeholder="Ghi chú" />



            </div>

            <!-- Cột chọn phương thức thanh toán -->
            <div class="col-12 col-md-4">
                <h3>Hình thức thanh toán</h3>
                <div class="card p-4 mb-3">
                    <label>
                        <input type="radio" name="Payment" value="COD" checked />
                        Thanh toán khi nhận hàng (COD)
                    </label>
                </div>
                <div class="card p-4 mb-3">
                    <label>
                        <input type="radio" name="Payment" value="BANK" />
                        Chuyển khoản ngân hàng
                    </label>
                </div>
                @* <div class="card p-4 mb-3">
                    <label>Phí giao hàng</label>
                    <select name="ShippingFee" id="PhiGiaoHang">
                        <option value="25000">Nội thành - 25.000₫</option>
                        <option value="50000">Ngoại thành - 50.000₫</option>
                        <option value="100000">Tỉnh xa - 100.000₫</option>
                    </select>
               </div> *@
                <!-- Modal --> <div class="modal fade" id="bankModal" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">Thông tin chuyển khoản</h5>
                                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body text-center">
                                <img src="~/images/AnhTk.jpg" alt="Tài khoản ngân hàng" style="max-width:100%;" />
                                <p><b>Ngân hàng:</b> VietTinBank</p>
                                <p><b>Số tài khoản:</b> 109876395116</p>
                                <p><b>Chủ tài khoản:</b> Nguyễn Mạnh Hùng</p>
                                <p><b> Nội dung: Thanh toán cho đơn hàng @Model.Name</b> </p>
                                <p><b>Tồng tiền: @string.Format("{0:N0}đ", Model.Price - Model.Discount)</b></p>
                                @* <p id="TongTienTk"><b>Số tiền:</b> @string.Format("{0:N0}đ", Model.Price - Model.Discount + 25000)</p> *@
                            </div>
                            <div class="modal-footer">
                                <div class="ThanhToan">
                                    <button type="submit" class="btn-pay" onclick="handlePayment()">Xác nhận thanh toán</button>
                                </div>
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- Cột giỏ hàng -->
            <div class="col-12 col-md-4">
                <h3>Giỏ hàng</h3>
                <div class="order-summary">

                    <!-- SẢN PHẨM -->
                    <div class="product-mini">
                        <img src="~/Upload/Products/@Model.Photo" alt="@Model.Name" />
                        <div class="info">
                            <h5>@Model.Name</h5>
                            <div class="variant">
                                @((ViewBag.Color as List<Color>)?.FirstOrDefault(c => c.Id == Context.Session.GetInt32("Ship_Color"))?.Name)
                                @((ViewBag.Size as List<Size>)?.FirstOrDefault(c => c.Id == Context.Session.GetInt32("Ship_Size"))?.Name)
                            </div>

                            <div class="price">
                                <del>@string.Format("{0:N0}đ", Model.Price)</del>
                                <span>@string.Format("{0:N0}đ", Model.Price - Model.Discount)</span>
                                <input type="hidden" name="SizeId" value="@Context.Session.GetInt32("Ship_Size")" />
                                <input type="hidden" name="ColorId" value="@Context.Session.GetInt32("Ship_Color")" />

                            </div>
                        </div>
                    </div>

                    <!-- TỔNG TIỀN -->
                    <div class="summary-box">
                        <div class="line">
                            <span>Tạm tính</span>
                            <span>@string.Format("{0:N0}đ", Model.Price)</span>
                        </div>

                        <div class="line">
                            <span>Giảm giá trực tiếp</span>
                            <span>-@string.Format("{0:N0}đ", Model.Discount)</span>
                        </div>

                        @* <div class="line">
                            <span>Phí giao hàng</span>
                            <span id="phiShip">+25.000đ</span>
                        </div> *@

                        <hr />

                        <div class="line total">
                            <span>Tổng</span>
                            <span class="total-price" id="tongTien">
                                @string.Format("{0:N0}đ", Model.Price - Model.Discount)
                            </span>
                        </div>
                    </div>

                    <!-- NÚT -->
                    <div class="ActionThanhToan">
                        <div class="ThanhToan">
                            @* <button type="submit" class="btn-pay">
                                Thanh toán Cod
                            </button> *@
                        </div>
                        <div class="ThanhToan">
                            @* <button type="button" class="btn-pay" >Xác nhận mua hàng Cod</button> *@
                            <button type="button" class="btn-pay" onclick="handlePayment()">Xác nhận mua hàng bank</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
