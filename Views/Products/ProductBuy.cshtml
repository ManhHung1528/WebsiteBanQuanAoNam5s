<script>
    // Lấy option Phí giao hàng để hiển thị
    const selectShip = document.getElementById("PhiGiaoHang");
    const phiShipSpan = document.getElementById("phiShip");
    // const tongTienSpan = document.getElementById("tongTien");
    // const tongTienTk = document.getElementById("TongTienTk");
    const basePrice = @Model.Price - @Model.Discount; // giá sau giảm

    // Khi thay đổi option
    selectShip.addEventListener("change", function () {
        const shipFee = parseInt(this.value);
        // cập nhật phí ship
        phiShipSpan.textContent = "+" + shipFee.toLocaleString("vi-VN") + "đ";
        // cập nhật tổng cộng
        tongTienSpan.textContent = (basePrice + shipFee).toLocaleString("vi-VN") + "đ";
        // tongTienTk.textContent = (basePrice + shipFee).toLocaleString("vi-VN") + "đ";
    });

    // Gọi hàm Modal chuyển khoản
        function handlePayment() {
        var payment = document.querySelector('input[name="Payment"]:checked').value;
        if (payment === "BANK") {
            // mở modal nếu chọn BANK
            $('#bankModal').modal('show');
        } else {
            // submit form nếu chọn COD
            document.querySelector('form').submit();
        }
    }
</script>


