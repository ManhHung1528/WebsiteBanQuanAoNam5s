@model Website.Models.Products

@{
	Layout = "~/Views/_Shared/_LayoutTrangTrong.cshtml";
}

@using Website.Models

@functions {
    public MyDbContext db = new MyDbContext();
    //lấy tên danh mục sản phẩm
    public string GetCategoryName(int _ProductId)
    {
        var record = (from category in db.Categories join category_product in db.categoriesProducts on category.Id equals category_product.CategoryId join product in db.Products on category_product.ProductId equals product.Id where product.Id == _ProductId select category).FirstOrDefault();
        return record != null ? record.Name : "";
    }
    //đánh giá số sao
    public string GetStar(int _ProductId, int _Star)
    {
        List<Rating> records = db.Ratings.Where(item => item.ProductId == _ProductId && item.Star == _Star).ToList();
        return records.Count().ToString();
    }
}
<div class="row">
    <div class="col-lg-6 mb-5 ftco-animate">
        <a  class="image-popup"><img src="~/Upload/Products/@Model.Photo" class="img-fluid" alt="Colorlib Template"></a>
    </div>
    <div class="col-lg-6 product-details pl-md-5 ftco-animate">
        <h3>@Model.Name</h3>
        <div class="rating d-flex">
            <p class="text-left mr-4">
                <a href="#"><span class="ion-ios-star-outline">@GetStar(Model.Id, 1) vote</span></a>
                <a href="#"><span class="ion-ios-star-outline"><span class="ion-ios-star-outline">@GetStar(Model.Id, 2) vote</span></a>
                <a href="#"><span class="ion-ios-star-outline"><span class="ion-ios-star-outline"><span class="ion-ios-star-outline">@GetStar(Model.Id, 3) vote</span></a>
                <a href="#"><span class="ion-ios-star-outline"><span class="ion-ios-star-outline"><span class="ion-ios-star-outline"><span class="ion-ios-star-outline">@GetStar(Model.Id, 4) vote</span></a>
                <a href="#"><span class="ion-ios-star-outline"><span class="ion-ios-star-outline"><span class="ion-ios-star-outline"><span class="ion-ios-star-outline"><span class="ion-ios-star-outline">@GetStar(Model.Id, 5) vote</span></a>
            </p>

            @{
                int star1 = int.Parse(GetStar(Model.Id, 1));
                int star2 = int.Parse(GetStar(Model.Id, 2));
                int star3 = int.Parse(GetStar(Model.Id, 3));
                int star4 = int.Parse(GetStar(Model.Id, 4));
                int star5 = int.Parse(GetStar(Model.Id, 5));

                int totalVote = star1 + star2 + star3 + star4 + star5;
            }
            <p> Vote: @totalVote</p>
