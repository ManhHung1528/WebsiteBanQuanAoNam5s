
<!DOCTYPE html>
<html>
<head>
	<title>Login</title>
	<meta charset="utf-8">
	@* Css cho Admin *@
	<link rel="stylesheet" type="text/css" href="~/Admin/css/CssLogin.css">
</head>
<body>
	<div class="container" >
		<div class="row">
			<div class="col-md-6 col-md-offset-3">
				<div class="panel panel-primary">
					<div class="panel-heading">Login</div>
					<div class="panel-body">
						<form method="post" action="/Admin/Account/LoginPost">
							<div class="row" style="margin-top:5px;">
								<div class="col-md-2 Email">Email</div>
								<div class="col-md-9"><input type="email" name="Email" required class="form-control input_Email"></div>
							</div>
							<div class="row" style="margin-top:5px;">
								<div class="col-md-2 Password">Password</div> 
								<div class="col-md-9"><input type="password" name="Password" required class="form-control input_Password"></div>
							</div>
							<div class="row" style="margin-top:5px;">
								<div class="col-md-2"></div>
								<div class="col-md-9"><input type="submit" value="Login" class="btn btn-primary"> <input type="reset" value="Reset" class="btn btn-danger"></div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>
</html>
