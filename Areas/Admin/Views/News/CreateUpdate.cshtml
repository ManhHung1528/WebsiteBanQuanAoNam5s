@{
    //set template
    Layout = "~/Areas/Admin/Views/_Shared/_Layout.cshtml";
}
@using Website.Models
@{
    string _Name = Model != null ? Model.Name : "";
    string _Description = Model != null ? Model.Description : "";
    string _Content = Model != null ? Model.Content : "";
    int _Hot = Model != null ? Model.Hot : 0;
    string _Photo = Model != null ? Model.Photo : "";
    int _Id = Model != null ? Model.Id : 0;
}
@functions {
    public MyDbContext db = new MyDbContext();
}

@* muốn load ckeditor thì phải khai bảo dòng dưới *@
<script src="https://cdn.ckeditor.com/ckeditor5/41.2.1/classic/ckeditor.js"></script>

<!-- select 2 -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>


<div class="col-md-12">
    <div class="panel panel-primary">
        <div class="panel-heading">Add edit New</div>
        <div class="panel-body">
            <!-- muốn upload được file thì cần có thuộc tính enctype="multipart/form-data" -->
            <form method="post" enctype="multipart/form-data" action="@ViewBag.formAction">
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2">Name</div>
                    <div class="col-md-10">
                        <input type="text" value="@_Name" name="Name" class="form-control" required>
                    </div>
                </div>
                <!-- end rows -->
                
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2">Categories</div>
                    <div class="col-md-10">                      
                        </select>
                        <script>
                        </script>
                    </div>
                </div>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2">Descripition</div>
                    <div class="col-md-10">
                        <textarea name="Description" id="Description">@_Description</textarea>
                    </div>
                </div>
                <script>
                    ClassicEditor
                        .create(document.querySelector('#Description'))
                        .catch(error => {
                            console.error(error);
                        });
                </script>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2">Content</div>
                    <div class="col-md-10">
                        <textarea name="Content" id="Content">@_Content</textarea>
                    </div>
                </div>
                <script>
                    ClassicEditor
                        .create(document.querySelector('#Content'))
                        .catch(error => {
                            console.error(error);
                        });
                </script>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2"></div>
                    <div class="col-md-10">
                        @{
                            string strChecked = _Hot == 1 ? "checked" : "";
                        }
                        <input type="checkbox" @strChecked name="Hot" id="Hot"> <label for="Hot">Hot</label>
                    </div>
                </div>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2">Upload image</div>
                    <div class="col-md-10">
                        <input type="file" name="img">
                    </div>
                </div>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2"></div>
                    <div class="col-md-10">
                        <input type="submit" value="Process" class="btn btn-primary">
                    </div>
                </div>
                <!-- end rows -->
            </form>
        </div>
    </div>
</div>
