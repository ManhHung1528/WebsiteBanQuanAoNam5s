@{
    //load file Layout.cshtml vao day
    Layout = "~/Areas/Admin/Views/_Shared/_Layout.cshtml";
}
@* de phan trang thi phai using cac doi tuong sau *@
@using X.PagedList
@using X.PagedList.Mvc.Core
@* doi tuong thao tac file *@
@using System.IO
@* nhin thay file MyDbContext *@
@using Website.Models
@functions {
    public MyDbContext db = new MyDbContext();
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<div class="col-md-12">
    <div style="margin-bottom:5px;">
        <a href="/Admin/Adv/Create" class="btn btn-primary">Add adv</a>
    </div>
    <div class="panel panel-primary">
        <div class="panel-heading">List adv</div>
        <div class="panel-body">
            <table class="table table-bordered table-hover">
                <tr>
                    <th style="width:100px;">Photo</th>
                    <th>Name</th>
                    <th style="width:150px;">Position</th>
                    <th style="width:100px;"></th>
                </tr>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @* File.Exists -> kiem tra file co ton tai khong *@
                            @* Directory.GetCurrentDirectory() -> lay duong dan thu muc *@
                            @if (item.Photo != null && File.Exists(Directory.GetCurrentDirectory() + "\\wwwroot\\Upload\\Adv\\" + item.Photo))
                            {
                                <img src="~/Upload/Adv/@item.Photo" style="width:100px;" />
                            }
                        </td>
                        <td>@item.Name</td>
                        <td>
                            @if (item.Position == 1)
                            {
                                <text>Trên HotPorducts</text>
                            }
                            @if (item.Position == 2)
                            {
                                <text>Trên Category-Products</text>
                            }
                            @if (item.Position == 3)
                            {
                                <text>Trang chủ trên - Footer</text>
                            }                     
                        </td>
                        <td style="text-align:center;">
                            <a href="/Admin/Adv/Update/@item.Id"><i class="fa-solid fa-pen-to-square"></i>Edit</a>&nbsp;
                            <a href="/Admin/Adv/Delete/@item.Id" onclick="return window.confirm('Bạn chắc chắn muốn xoá?');"><i class="fa-solid fa-trash-can"></i>Delete</a>
                        </td>
                    </tr>
                }
            </table>
            <style type="text/css">
                .pagination {
                    padding: 0px;
                    margin: 0px;
                }
            </style>
            @* ham sau se thuc hien viec hien thi phan trang *@
            @Html.PagedListPager((IPagedList)Model, p => Url.Action("Index", new { page = p }))
        </div>
    </div>
</div>
<style>
    .pagination {
        margin: 15px 0 0;
        display: flex;
    }

        .pagination .active span {
            background: #4f46e5;
            color: #fff;
            border-color: #4f46e5;
        }

        .pagination li a, .pagination li span {
            padding: 6px 12px;
            margin: 0 3px;
            border-radius: 5px;
            border: 1px solid #e5e7eb;
            color: #4f46e5;
            font-size: 14px;
        }
</style>