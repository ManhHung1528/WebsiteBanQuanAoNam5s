@{
    //load file layout vao day
    Layout = "~/Areas/Admin/Views/_Shared/_Layout.cshtml";
}
@using Website.Models
@functions {
    public MyDbContext db = new MyDbContext();
}
<div class="col-md-12">
    <div class="panel panel-primary">
        <div class="panel-heading">Add edit adv</div>
        <div class="panel-body">
            @* muon upload duoc file thi phai co thuoc tinh enctype=mulipart/form-data *@
            <form method="post" enctype="multipart/form-data" action="">
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2">Name</div>
                    <div class="col-md-10">
                        <input type="text" value="@if (Model != null) {
                        <text>@Model.Name</text>
                                                }
" name="Name" class="form-control" required>
                    </div>
                </div>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2">Position</div>
                    <div class="col-md-10">
                        <select name="Position" class="form-control" style="width:250px;">
                            <option @if (Model != null && Model.Position == 1) 
                            {
                            <text> selected</text>
                            }
                             value="1">Trang chủ (Trên tin nổi bật)</option>
                                                        <option @if (Model != null && Model.Position == 2) {
                                                        <text> selected</text>
                                                                                    }
                             value="2">Trang chủ (Trên sản phẩm theo danh mục)</option>
                                                        <option @if (Model != null && Model.Position == 3) {
                                                        <text> selected</text>
                                                                                    }
                             value="3">Trang sản phẩm (Trên footer)</option>
                        </select>
                    </div>
                </div>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2">Photo</div>
                    <div class="col-md-10">
                        <input type="file" name="Photo" />
                    </div>
                </div>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2"></div>
                    <div class="col-md-10">
                        <input type="submit" value="Process" class="btn btn-primary">
                    </div>
                </div>
                <!-- end rows -->
            </form>
        </div>
    </div>
</div>