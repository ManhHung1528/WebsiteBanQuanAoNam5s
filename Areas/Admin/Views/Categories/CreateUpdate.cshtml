@{
    //set template
    Layout = "~/Areas/Admin/Views/_Shared/_Layout.cshtml";
}
@using Website.Models
@{
    string name = Model != null ? Model.Name : "";
    int parent_id = Model != null ? Model.ParentId : 0;
    int display_home_page = Model != null ? Model.DisplayHomePage : 0;
    int id = Model != null ? Model.Id : 0;
}
@functions {
    public MyDbContext db = new MyDbContext();
    public List<RowCategory> GetCategories()
    {
        List<RowCategory> listCategories = db.Categories.Where(item => item.ParentId == 0).ToList();
        return listCategories != null ? listCategories : new List<RowCategory>();
    }
}
<div class="col-md-12">
    <div class="panel panel-primary">
        <div class="panel-heading">Add edit user</div>
        <div class="panel-body">
            <form method="post" action="@ViewBag.formAction">
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2">Name</div>
                    <div class="col-md-10">
                        <input type="text" value="@name" name="name" class="form-control" required>
                    </div>
                </div>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2">Danh mục cha</div>
                    <div class="col-md-10">
                        <!-- multiple là thuộc tính cho phép chọn nhiều danh mục -->
                        <select class="form-control" style="width:100%;" name="ParentId">
                            <option value="0"></option>
                            @{
                                var listCategories = GetCategories();
                            }
                            @foreach (var item in listCategories)
                            {
                                string str_selected = Model != null && Convert.ToInt32(Model.ParentId) == item.Id ? "selected" : "";
                                <option @str_selected value="@item.Id">@item.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2"></div>
                    <div class="col-md-10">
                        @{
                            string str_checked = Model != null && Convert.ToInt32(Model.DisplayHomePage) == 1 ? "checked" : "";
                        }
                        <input type="checkbox" @str_checked name="DisplayHomePage" id="DisplayHomePage" /> <label for="DisplayHomePage">Display Home Page</label>
                    </div>
                </div>
                <!-- end rows -->
                <!-- rows -->
                <div class="row" style="margin-top:5px;">
                    <div class="col-md-2"></div>
                    <div class="col-md-10">
                        <input type="submit" value="Process" class="btn btn-primary">
                    </div>
                </div>
                <!-- end rows -->
            </form>
        </div>
    </div>
</div>